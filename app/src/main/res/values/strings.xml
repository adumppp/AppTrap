    <string name="app_name">AppTrap</string>

    <!-- ===== Onboarding ===== -->
    <string name="onb_title">See which apps ask for too much</string>
    <string name="onb_sub">AppTrap checks the apps on your phone and tells you, in simple words, which ones ask for more than they need.</string>
    <string name="onb_point_1_title">Nothing leaves your phone</string>
    <string name="onb_point_1_body">The check happens right here. We never upload your apps or your data.</string>
    <string name="onb_point_2_title">Takes about a minute</string>
    <string name="onb_point_2_body">You can keep using your phone while we look.</string>
    <string name="onb_point_3_title">You decide what to do</string>
    <string name="onb_point_3_body">We only explain. Removing an app is always your choice.</string>
    <string name="onb_cta">Start my check</string>
    <string name="onb_skip">Maybe later</string>

