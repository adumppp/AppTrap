<?xml version="1.0" encoding="utf-8"?>
<!-- Springy dialog entrance (Tailwind "animate-in zoom-in-95 fade-in" feel). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/overshoot">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="160" />
    <scale
        android:fromXScale="0.92" android:toXScale="1"
        android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="260" />
    <translate android:fromYDelta="4%p" android:toYDelta="0" android:duration="260" />
</set>
