<?xml version="1.0" encoding="utf-8"?>
<!--
  Idle hero shield: scale + glow breathing, matching the prototype's
  pulse-breath keyframe (scale 1 -> 1.12 with a soft light pulse).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:fromXScale="1" android:toXScale="1.12"
        android:fromYScale="1" android:toYScale="1.12"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="1800"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
    <alpha
        android:fromAlpha="1.0" android:toAlpha="0.82"
        android:duration="1800"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
</set>
