<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing screen fades through (open + close-exit counterpart). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quint">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="220" />
    <scale
        android:fromXScale="1" android:toXScale="0.98"
        android:fromYScale="1" android:toYScale="0.98"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="220" />
</set>