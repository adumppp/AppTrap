<?xml version="1.0" encoding="utf-8"?>
<!-- Safe app row (ConsistentAppsAdapter). Quiet, no alarm colours. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Apptrap.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_placeholder_bg"
            android:contentDescription="@string/cd_app_icon"
            android:padding="5dp"
            tools:src="@drawable/ic_security" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_md"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.Apptrap.Title"
            android:textSize="14sp"
            tools:text="Calculator" />

        <TextView
            android:id="@+id/safeBadge"
            style="@style/Badge.Apptrap.Safe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safe_badge" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
