<?xml version="1.0" encoding="utf-8"?>
<!-- Exit feedback nudge — kit styling, keeps "don't ask again" + cancel. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card.Apptrap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_xl"
    app:contentPadding="@dimen/space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit_title"
            android:textAppearance="@style/Text.Apptrap.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/exit_body"
            android:textAppearance="@style/Text.Apptrap.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGiveFeedback"
            style="@style/Button.Apptrap.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/home_feedback"
            app:icon="@drawable/ic_info"
            app:iconTint="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJustExit"
            style="@style/Button.Apptrap.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit_no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="?attr/colorOutline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chkDontAskAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_dont_ask"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_cancel" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
