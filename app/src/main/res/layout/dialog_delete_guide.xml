<?xml version="1.0" encoding="utf-8"?>
<!--
  NEW: shown before firing the uninstall intent, so removal is never a
  surprise. Explains what happens next and what is NOT affected.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Apptrap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_xl"
    app:contentPadding="@dimen/space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="?attr/riskDangerContainer">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_delete" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtDeleteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/Text.Apptrap.Headline"
            tools:text="Remove Super Torch Light?" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/delete_body"
            android:textAppearance="@style/Text.Apptrap.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDelete"
            style="@style/Button.Apptrap.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/delete_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDelete"
            style="@style/Button.Apptrap.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_cancel" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
